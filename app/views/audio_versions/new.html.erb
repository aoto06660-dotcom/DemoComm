<h1>音源をアップロード</h1>

<h2><%= @project.title %></h2>

<% if @audio_version.errors.any? %>
  <ul class="feedback feedback--error" role="alert">
    <% @audio_version.errors.full_messages.each do |message| %>
      <li><%= message %></li>
    <% end %>
  </ul>
<% end %>

<%= form_with model: [@project, @audio_version] do |f| %>
  <div>
    <%= f.label :audio_file, "音源ファイル" %>
    <p id="audio-formats" class="muted">対応形式はMP3とWAVです。</p>
    <%= f.file_field :audio_file, accept: ".mp3,.wav,audio/mpeg,audio/wav", aria: { describedby: "audio-formats" } %>
  </div>

  <div>
    <%= f.submit "アップロード" %>
  </div>
<% end %>

<%= link_to "プロジェクトの詳細へ戻る", project_path(@project) %>