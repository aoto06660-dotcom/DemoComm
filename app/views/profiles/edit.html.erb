<h1>プロフィール編集</h1>

<% if @user.errors.any? %>
  <ul>
    <% @user.errors.full_messages.each do |message| %>
      <li><%= message %></li>
    <% end %>
  </ul>
<% end %>

<%= form_with model: @user, url: profile_path do |f| %>
  
  <div>
    <%= f.label :name, "ユーザー名" %>
    <%= f.text_field :name %>
  </div>

  <div>
    <%= f.label :bio, "自己紹介" %>
    <%= f.text_area :bio, row: 5 %>
  </div>

  <div>
    <%= f.label :avatar, "プロフィール画像" %>
    <%= f.file_field :avatar, 
                    accept: "image/jpeg, image/png, image/webp" %>
  </div>

  <%= f.submit "更新する" %>

<% end %>

<%= link_to "アカウントを設定", edit_user_registration_path %>
<%= link_to "戻る", profile_path %>