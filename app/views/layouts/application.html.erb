<!DOCTYPE html>
<html lang="ja">
  <head>
    <title><%= content_for(:title) || "Demo Comm" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Demo Comm">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>

    <a class="skip-link" href="#main-content">本文へ移動</a>
    <header class="site-header">
      <div class="site-header__inner">
        <%= link_to home_index_path, class: "brand" do %>
          <%= image_tag "DemoComm_logo.png", alt: "DemoComm", width: 216, height: 72 %>
        <% end %>
        <nav aria-label="メインナビゲーション">
          <%= link_to "公開プロジェクト", projects_path, aria: { current: current_page?(projects_path) ? "page" : nil } %>
          <% if user_signed_in? %>
            <%= link_to "マイプロジェクト", mine_projects_path, aria: { current: current_page?(mine_projects_path) ? "page" : nil } %>
            <%= link_to "招待", invitations_path, aria: { current: current_page?(invitations_path) ? "page" : nil } %>
            <%= link_to "プロフィール", profile_path, aria: { current: current_page?(profile_path) ? "page" : nil } %>
          <% else %>
            <%= link_to "ログイン", new_user_session_path, aria: { current: current_page?(new_user_session_path) ? "page" : nil } %>
          <% end %>
        </nav>
        <% if user_signed_in? %>
          <div class="site-header__account">
            <details class="account-menu" data-controller="account-menu"
                     data-action="click@document->account-menu#closeOutside keydown.esc->account-menu#closeAndFocus turbo:before-cache@document->account-menu#close">
              <summary class="account-menu__trigger" data-account-menu-target="trigger">
                <%= image_tag(current_user.avatar.attached? ? profile_avatar_path : "profile_no_image.png",
                              alt: "", width: 32, height: 32, class: "account-menu__avatar") %>
                <span class="account-menu__name"><%= current_user.name %></span>
              </summary>
              <div class="account-menu__links">
                <%= link_to "プロフィール編集", edit_profile_path %>
                <%= link_to "アカウントの設定", edit_user_registration_path %>
                <%= button_to "ログアウト", destroy_user_session_path, method: :delete, class: "account-menu__logout",
                              form: { data: { turbo_confirm: "ログアウトしますか？" } } %>
              </div>
            </details>
            <%= button_to "ログアウト", destroy_user_session_path, method: :delete, class: "button button--secondary",
                              form: { data: { turbo_confirm: "ログアウトしますか？" } } %>
          </div>
        <% end %>
      </div>
    </header>

    <main id="main-content" class="page" tabindex="-1">
      <% if notice.present? %>
        <div class="feedback" role="status" data-turbo-temporary>
          <%= notice %>
          <% if user_signed_in? && flash[:show_my_projects_link] %>
            <%= link_to "マイプロジェクトで確認", mine_projects_path %>
          <% end %>
        </div>
      <% end %>
      <% if alert.present? %>
        <div class="feedback feedback--error" role="alert" data-turbo-temporary><%= alert %></div>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
