<h1><%= @project.title %></h1>

<p>
  作成者：<%= @project.user.name %>
</p>

<p>
  公開範囲：<%= @project.visibility_public? ? "公開" : "非公開" %>
</p>

<p>
  作成日：<%= @project.created_at.strftime("%Y年%m月%d日") %>
</p>

<%= link_to "プロジェクト一覧へ戻る", projects_path %>

<% if user_signed_in? && @project.user_id == current_user.id %>
  <%= link_to "音源をアップロード", new_project_audio_version_path(@project) %>

  <%= link_to "編集", edit_project_path(@project) %>

  <%= button_to "削除",
                project_path(@project),
                method: :delete,
                data: {
                  turbo_confirm: "本当に削除しますか？"
                } %>
<% end %>

<h2>アップロード音源一覧</h2>

<% if @audio_versions.any? %>
  <ul>
    <% @audio_versions.each do |audio_version| %>
    <li data-controller="audio-comment">
        <h3>Version <%= audio_version.version_number %></h3>  

        <% if audio_version.audio_file.attached? %>
          <audio controls preload="metadata"
                data-audio-comment-target="audio">
            <source
              src="<%= play_audio_version_path(audio_version) %>"
              type="<%= audio_version.audio_file.blob.content_type %>">

            お使いのブラウザは音源再生に対応していません
          </audio>
        <% end %>

        <% if user_signed_in? %>
          <h4>コメントを投稿</h4>

          <%= form_with model: [@project, audio_version, Comment.new],
                        data: { audio_comment_form: true } do |f| %>
            <div>
              <%= f.label :body, "コメント" %>
              <%= f.text_area :body, rows: 3, placeholder: "コメントを入力" %>
            </div>

            <%= f.hidden_field :playback_seconds,
                              data: { audio_comment_target: "seconds" } %>

            <p>
              記録する再生位置：
              <span data-audio-comment-target="display">未設定</span>
            </p>

            <button type="button" 
                          data-action="click->audio-comment#captureTime">
              現在の再生位置を指定
            </button>

            <%= f.submit "投稿" %>
          <% end %>

          <h4>コメント一覧</h4>

          <% if audio_version.comments.any? %>
            <% audio_version.comments.each do |comment| %>
              <div>
                <p>
                  <strong><%= comment.user.name %></strong>
                  <%= comment.created_at.strftime("%Y-%m-%d %H時%M分%S秒") %>
                </p>

                <% if comment.playback_seconds.present? %>
                  <% minnutes = comment.playback_seconds / 60 %>
                  <% seconds = comment.playback_seconds % 60 %>

                  <button type ="button"
                          data-action="click->audio-comment#seekTo"
                          data-seconds="<%= comment.playback_seconds %>">
                    <%= format("%02d:%02d", minnutes, seconds) %>
                  </button>
                <% end %>
            
                <p><%= comment.body %></p>

                <% if user_signed_in? && comment.user_id == current_user.id %>

                  <%= link_to "編集",
                              edit_project_audio_version_comment_path(
                              @project,
                              audio_version,
                              comment
                            ) %>

                  <%= button_to "削除",
                                project_audio_version_comment_path(
                                  @project,
                                  audio_version,
                                  comment
                                ),
                                method: :delete,
                                data: { turbo_confirm: "このコメントを削除しますか？" } %>
                <% end %>   
              </div>
            <% end %>
          <% end %>

        <% else %>
          <p>コメントを投稿するには<%= link_to "ログイン", new_user_session_path %>が必要です</p>
        <% end %>

        <p>
          ファイル名：
          <%= audio_version.audio_file.filename %>
        </p>

        <p>
          アップロード日時：
          <%= audio_version.created_at.strftime("%Y-%m-%d %H時%M分%S秒") %>
        </p>

        <p>
          アップロード者：
          <%= audio_version.uploaded_by.name %>
        </p>
      </li>
    <% end %>
  </ul>
<% else %>
  <p>まだ音源がアップロードされていません</p>
<% end %>



