<header class="project-heading">
  <%= link_to "公開プロジェクト一覧", projects_path %>
  <h1><%= @project.title %></h1>
  <div class="actions">
    <span class="badge">公開範囲 <%= @project.visibility_public? ? "公開" : "非公開" %></span>
    <span class="badge">役割 <%= @project.owner?(current_user) ? "オーナー" : (@project.accepted_member?(current_user) ? "参加中" : "閲覧者") %></span>
  </div>
  <p class="muted"><%= @project.user.name %> · <%= @project.created_at.strftime("%Y年%m月%d日") %> 作成</p>
</header>

<div class="project-layout">
  <section aria-labelledby="audio-heading">
    <div class="section-heading">
      <h2 id="audio-heading">音源とコメント</h2>
      <% if @project.uploadable_by?(current_user) %>
        <%= link_to "音源をアップロード", new_project_audio_version_path(@project), class: "button" %>
      <% end %>
    </div>
    <div class="stack">
      <%= render partial: "audio_version", collection: @audio_versions, locals: { project: @project } %>
      <% if @audio_versions.empty? %>
        <p class="empty">まだ音源がアップロードされていません。</p>
      <% end %>
    </div>
  </section>

  <aside class="stack" aria-label="メンバーとプロジェクト管理">
    <section class="panel">
      <h2>メンバー</h2>
      <ul class="members">
        <li><strong><%= @project.user.name %></strong> <span class="badge">オーナー</span></li>
        <% @memberships.each do |membership| %>
          <li>
            <strong><%= membership.user.name %></strong> <span class="badge">参加中</span>
            <% if @project.owner?(current_user) %>
              <%= button_to "メンバーを解除", project_project_membership_path(@project, membership),
                            method: :delete, class: "button button--danger",
                            data: { turbo_confirm: "このメンバーを解除しますか？ このメンバーが投稿した音源とコメント、およびその音源に付いた他のユーザーのコメントも削除されます。" } %>
            <% end %>
          </li>
        <% end %>
      </ul>
      <% if @project.owner?(current_user) %>
        <%= form_with url: project_project_memberships_path(@project), method: :post do |f| %>
          <div>
            <%= f.label :email, "メールアドレスで招待" %>
            <%= f.email_field :email, required: true, placeholder: "member@example.com" %>
          </div>
          <%= f.submit "招待する" %>
        <% end %>
      <% end %>
    </section>
    <% if @project.owner?(current_user) || @project.accepted_member?(current_user) %>
      <section class="panel">
        <h2>プロジェクト管理</h2>
        <div class="actions">
          <% if @project.owner?(current_user) %>
            <%= link_to "編集", edit_project_path(@project), class: "button button--secondary" %>
            <%= button_to "削除", project_path(@project), method: :delete, class: "button button--danger",
                          data: { turbo_confirm: "プロジェクトとその音源・コメントを削除しますか？" } %>
          <% else %>
            <%= button_to "プロジェクトから退出する", leave_project_path(@project),
                          method: :delete, class: "button button--danger",
                          data: { turbo_confirm: "プロジェクトから退出しますか？ あなたが投稿した音源とコメント、およびその音源に付いた他のユーザーのコメントも削除されます。" } %>
          <% end %>
        </div>
      </section>
    <% end %>
  </aside>
</div>
