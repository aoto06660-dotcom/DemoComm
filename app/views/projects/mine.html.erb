<h1>マイプロジェクト</h1>

<%= link_to "新規プロジェクト作成", new_project_path %>

<% if @projects.any? %>
  <ul>
    <% @projects.each do |project| %>
      <li>
        <%= link_to project.title, project_path(project) %>

        <% if project.visibility_public? %>
          <span>公開</span>
        <% else %>
          <span>非公開</span>
        <% end %>

        <span>
          作成日：
          <%= project.created_at.strftime("%Y年%m月%d日 %H時%M分") %>
        </span>
      </li>
    <% end %>
  </ul>
<% else %>
  <p>まだプロジェクトがありません</p>
<% end %>
