<h1>マイプロジェクト</h1>

<%= link_to "新規プロジェクト作成", new_project_path %>

<h2>作成したプロジェクト</h2>

<% if @my_projects.any? %>
  <% @my_projects.each do |project| %>
    <div>
      <h3>
        <%= link_to project.title, project_path(project) %>
      </h3>

      <p>
        <%= project.visibility_public? ? "公開" : "非公開" %>
      </p>

      <span>
        作成日：
        <%= project.created_at.strftime("%Y年%m月%d日 %H時%M分") %>
      </span>
    </div>
  <% end %>
<% else %>
  <p>作成したプロジェクトはありません</p>
<% end %>

<h2>参加中のプロジェクト</h2>

<% if @joined_projects.any? %>
  <% @joined_projects.each do |project| %>
    <div>
      <h3>
        <%= link_to project.title, project_path(project) %>
      </h3>

      <p>オーナー：<%= project.user.name %></p>

      <p>
        <%= project.visibility_public? ? "公開" : "非公開" %>
      </p>
    </div>
  <% end %>
<% else %>
  <p>参加中のプロジェクトはありません</p>
<% end %>
