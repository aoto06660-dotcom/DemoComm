<% if @project.errors.any? %>
  <ul class="feedback feedback--error" role="alert">
    <% @project.errors.full_messages.each do |message| %>
      <li><%= message %></li>
    <% end %>
  </ul>
<% end %>

<%= form_with model: @project do |f| %>
  <div>
    <%= f.label :title, "楽曲タイトル" %>
    <%= f.text_field :title %>
  </div>

  <div>
    <%= f.label :visibility, "公開範囲" %>
    <%= f.select :visibility,
                 [["非公開", "private"], ["公開", "public"]],
                 {}, aria: { describedby: "visibility-help" } %>
    <p id="visibility-help" class="muted">非公開はオーナーと参加中のメンバーのみ。公開は誰でも閲覧・再生できます。</p>
  </div>

  <%= f.submit(@project.persisted? ? "変更を保存" : "プロジェクトを作成") %>
<% end %>