<div class="section-heading">
  <h1>公開プロジェクト</h1>
  <% if user_signed_in? %>
    <%= link_to "プロジェクトを作成", new_project_path, class: "button" %>
  <% end %>
</div>

<div class="card-grid">
  <% @projects.each do |project| %>
    <article class="panel">
      <span class="badge">公開</span>
      <h2><%= link_to project.title, project_path(project) %></h2>
      <p class="muted">オーナー <%= project.user.name %></p>
    </article>
  <% end %>
</div>
<% if @projects.empty? %>
  <p class="empty">公開されているプロジェクトはありません。</p>
<% end %>
