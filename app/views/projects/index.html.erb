<h1>公開プロジェクト一覧</h1>

<% if user_signed_in? %>
  <%= link_to "プロジェクトの新規作成", new_project_path %>
<% end %>

<% if @projects.any? %>
  <% @projects.each do |project| %>
    <div>
      <h2>
        <%= link_to project.title, project_path(project) %>
      </h2>
      <p>作成者：<%= project.user.name %><p>
    </div>
  <% end %>
<% else %>
  <p>公開されているプロジェクトはありません</p>
<% end %>